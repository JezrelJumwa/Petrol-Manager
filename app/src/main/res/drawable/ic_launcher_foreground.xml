<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Speedometer gauge icon (safe zone: 18–90 on each axis, center 54,54)
        Arc geometry: center (54,57), radius 28
          8 o'clock (SVG 150°): (30, 71)
          4 o'clock (SVG  30°): (78, 71)
          12 o'clock (SVG 270°): (54, 29)
    -->

    <!-- Full gauge track: 8 o'clock → 4 o'clock, 240° CW (large-arc=1, sweep=1) -->
    <path
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M30,71 A28,28 0 1,1 78,71" />

    <!-- Active arc (amber): 8 o'clock → 12 o'clock, 120° CW (large-arc=0, sweep=1) -->
    <path
        android:strokeColor="#FFB300"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M30,71 A28,28 0 0,1 54,29" />

    <!-- Needle: center → 12 o'clock (inner, r=22) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M54,57 L54,35" />

    <!-- Hub outer ring (white), two right-semicircles through top and bottom -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,52 A5,5 0 0,1 54,62 A5,5 0 0,1 54,52 Z" />

    <!-- Hub inner fill (dark navy) -->
    <path
        android:fillColor="#0D1B35"
        android:pathData="M54,54.5 A2.5,2.5 0 0,1 54,59.5 A2.5,2.5 0 0,1 54,54.5 Z" />

    <!-- Fuel-drop shape (amber): round top + pointed bottom -->
    <!-- Top half-arc CCW left→right, then line to point, close -->
    <path
        android:fillColor="#FFB300"
        android:pathData="M48,80 A6,6 0 0,0 60,80 L54,88 Z" />

    <!-- Fuel-drop highlight (translucent white) -->
    <path
        android:fillColor="#60FFFFFF"
        android:pathData="M51.5,76.5 A2,1.5 0 0,0 54.5,75 A2,1.5 0 0,0 51.5,76.5 Z" />

</vector>
